# Required — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public site origin (used for admin invite/OAuth redirects in email links)
# Must match your Vercel primary domain exactly (www vs non-www matters for invite links).
NEXT_PUBLIC_SITE_URL=https://www.normie.one

# Google Analytics 4 (loaded in production only via app/layout.tsx)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-GDP5RCN78R

# Optional — auth email hook (builder email templates → Resend)
# Required when Supabase Authentication → Auth Hooks → Send Email points at /api/auth/send-email
RESEND_API_KEY=
AUTH_EMAIL_FROM="Normie <noreply@normie.one>"
# Optional override for logo/footer URLs in auth emails (defaults to https://www.normie.one when NEXT_PUBLIC_SITE_URL is localhost)
# AUTH_EMAIL_SITE_URL=https://www.normie.one
SEND_EMAIL_HOOK_SECRET=
HEALTH_CHECK_TOKEN=

# Optional — observability
LOG_LEVEL=info

# Server-only — Solana RPC (Helius mainnet; used for $NORMIE wallet balances in Player Portal)
# Use EITHER the base URL + separate key, OR the full Helius URL that already includes ?api-key=...
# SOLANA_RPC_URL=https://mainnet.helius-rpc.com
# SOLANA_RPC_API_KEY=
# Aliases also supported: HELIUS_RPC_URL, HELIUS_API_KEY, HELIUS_RPC_API_KEY
# In Vercel: enable for Production, save, then redeploy (env changes do not apply to past deployments).

# Supabase Auth (Supabase Dashboard → Authentication → URL configuration)
# Site URL (production): same as NEXT_PUBLIC_SITE_URL (e.g. https://www.normie.one)
# Additional Redirect URLs (allowlist every origin you use):
#   https://normie.one/admin/auth/callback
#   https://www.normie.one/admin/auth/callback
#   https://normie.one/admin?invite=1
#   https://www.normie.one/admin?invite=1
#   http://localhost:3000/admin/auth/callback
#   http://localhost:3000/admin?invite=1
#
# Invite emails always pass through your-project.supabase.co/auth/v1/verify first;
# the redirect_to query param is set from NEXT_PUBLIC_SITE_URL via the invite API.
#
# OAuth providers (Google, etc.) are enabled in Supabase; no extra env vars required here.
