# Required — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public site origin (used for admin invite/OAuth redirects in email links)
# Must match your Vercel primary domain exactly (www vs non-www matters for invite links).
NEXT_PUBLIC_SITE_URL=https://www.normie.one

# Optional — observability
LOG_LEVEL=info
HEALTH_CHECK_TOKEN=

# Supabase Auth (Supabase Dashboard → Authentication → URL configuration)
# Site URL (production): same as NEXT_PUBLIC_SITE_URL (e.g. https://www.normie.one)
# Additional Redirect URLs (allowlist every origin you use):
#   https://normie.one/admin/auth/callback
#   https://www.normie.one/admin/auth/callback
#   https://normie.one/admin?invite=1
#   https://www.normie.one/admin?invite=1
#   http://localhost:3000/admin/auth/callback
#   http://localhost:3000/admin?invite=1
#
# Invite emails always pass through your-project.supabase.co/auth/v1/verify first;
# the redirect_to query param is set from NEXT_PUBLIC_SITE_URL via the invite API.
#
# OAuth providers (Google, etc.) are enabled in Supabase; no extra env vars required here.
