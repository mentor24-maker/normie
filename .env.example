# Required — Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — observability
LOG_LEVEL=info
HEALTH_CHECK_TOKEN=

# Supabase Auth (configure in Supabase Dashboard → Authentication → URL configuration)
# Site URL (production): https://YOUR_DOMAIN
# Redirect URLs must include:
#   https://YOUR_DOMAIN/admin/auth/callback
#   http://localhost:3000/admin/auth/callback
#
# OAuth providers (Google, etc.) are enabled in Supabase; no extra env vars required here.
