    "@types/node": "^22.15.19",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "^15.3.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  }
}
