{
  "name": "normie-polls",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/ensure-devtools-config.mjs && next dev -p 3000",
    "dev:reset": "bash ./scripts/dev-reset.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:ci": "npm audit --audit-level=high --omit=dev",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:ci",
    "verify:full": "npm run verify && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "@tiptap/core": "^3.22.5",
    "@tiptap/extension-color": "^3.22.5",
    "@tiptap/extension-image": "^3.23.4",
    "@tiptap/extension-link": "^3.23.4",
    "@tiptap/extension-table": "^3.23.4",
    "@tiptap/extension-table-cell": "^3.23.4",
    "@tiptap/extension-table-header": "^3.23.4",
    "@tiptap/extension-table-row": "^3.23.4",
    "@tiptap/extension-text-align": "^3.22.5",
    "@tiptap/extension-text-style": "^3.22.5",
    "@tiptap/extension-underline": "^3.22.5",
    "@tiptap/pm": "^3.22.5",
    "@tiptap/react": "^3.22.5",
    "@tiptap/starter-kit": "^3.22.5",
    "canvas-confetti": "^1.9.4",
    "isomorphic-dompurify": "^3.18.0",
    "next": "^16.2.10",
    "papaparse": "^5.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "simple-icons": "^16.25.0",
    "standardwebhooks": "^1.0.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.20.1",
    "@types/papaparse": "^5.3.16",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.1.4",
    "eslint": "^9.28.0",
    "eslint-config-next": "^16.3.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.8.3",
    "vitest": "^3.2.1"
  },
  "overrides": {
    "postcss": "^8.5.25",
    "sharp": "^0.35.3",
    "brace-expansion@^1.0.0": "^1.1.18",
    "brace-expansion@^2.0.0": "^2.1.4",
    "brace-expansion@^4.0.0": "^4.0.1",
    "brace-expansion@^5.0.0": "^5.0.9"
  }
}
