{
  "name": "normie-polls",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:reset": "bash ./scripts/dev-reset.sh",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "audit:ci": "npm audit --audit-level=high",
    "verify": "npm run typecheck && npm run lint && npm test && npm run audit:ci",
    "verify:full": "npm run verify && npm run build"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.8",
